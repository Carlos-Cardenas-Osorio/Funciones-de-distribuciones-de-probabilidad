}, 0, u)$value - x
}, interval = c(0, 1))$root
} else if (tipo == "r") {
# Una Beta(shape1, shape2) se obtiene como X / (X + Y) donde X ~ Gamma(shape1, 1) y Y ~ Gamma(shape2, 1)
replicate(x, {
g1 <- sum(-log(runif(ceiling(shape1))))
g2 <- sum(-log(runif(ceiling(shape2))))
g1 / (g1 + g2)
})
}
}
